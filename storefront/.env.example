# ---- Backend (Mercur / Medusa) ----
# Where the backend runs. Local: http://localhost:9000  · Render: https://<your-service>.onrender.com
MEDUSA_BACKEND_URL=http://localhost:9000
# The storefront key printed at the end of `npm run seed` in backend/packages/api
# (also in the admin panel: Settings → Publishable API keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxx

# ---- This site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# store | coming-soon  (what "/" shows)
NEXT_PUBLIC_SITE_MODE=store
NEXT_PUBLIC_SHOW_DRESSES=false
# The vendor panel (link in the footer and account page)
NEXT_PUBLIC_VENDOR_PANEL_URL=http://localhost:9000/seller
# Must match STOREFRONT_REVALIDATE_SECRET in the backend .env
REVALIDATE_SECRET=change-me

# ---- Optional ----
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FORM_ENDPOINT=
