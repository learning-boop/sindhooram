# ======================================================================
# Sindhooram backend settings. Copy to .env (local) or set them on Render.
# ======================================================================

# PostgreSQL. Local Mac (Postgres.app / Homebrew): postgres://<mac-username>@localhost:5432/sindhooram
# Neon: use the DIRECT connection string (not the "-pooler" one), it already includes ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sindhooram

# Secrets that sign logins. Any long random text; never reuse the local ones in production.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Who may call the APIs from a browser (comma-separated, no trailing slashes)
#   STORE_CORS  the storefront          (local: http://localhost:3000)
#   ADMIN_CORS  the owner panel origin  (the backend itself: http://localhost:9000)
#   VENDOR_CORS the vendor panel origin (the backend itself: http://localhost:9000)
#   AUTH_CORS   all of the above
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:7000,http://localhost:7001,http://localhost:9000

# Public address of this backend, baked into the panels when they are built (production only)
MERCUR_BACKEND_URL=http://localhost:9000
# Uploaded product photos are served from here (local disk). On Render set the S3_* values below instead.
FILE_BACKEND_URL=http://localhost:9000/static
# Vendor panel address, used in team-invite emails
MERCUR_VENDOR_URL=http://localhost:9000/seller

# The storefront: product photos of the demo sarees live there, and it refreshes its cache when products change
STOREFRONT_URL=http://localhost:3000
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=supersecret

# Demo logins created by `bun run seed` (change before seeding a public demo)
SEED_ADMIN_EMAIL=admin@sindhooram.com
SEED_ADMIN_PASSWORD=Sindhooram@123
SEED_VENDOR_PASSWORD=Vendor@123
# Platform commission on every sale, in percent (also editable later in the owner panel)
COMMISSION_PERCENT=10

MERCUR_DISABLE_TELEMETRY=true

# ---------- optional (production) ----------
# Redis: shared events/locks/cache. Leave empty to run everything in memory (fine for one server).
# REDIS_URL=redis://localhost:6379
# Durable photo storage (AWS S3, Cloudflare R2, Supabase Storage...). Needed on Render, whose disk is wiped on restart.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=https://<public-bucket-url>
